<?xml version="1.0" ?>
<!--
    damaged_shelter.sdf
    ====================
    Gazebo SDF world file defining a structurally damaged single-storey shelter.

    This world simulates the post-disaster state of a residential shelter after
    a major seismic event. The model includes:
        - Partially collapsed North-West wall
        - Roof hole above the main living area
        - Scattered debris (concrete blocks) on the floor
        - Remaining intact exterior walls
        - Floor slab with realistic friction properties

    SDF Version : 1.7
    Simulator   : Gazebo 11 (Classic) / Gazebo Fortress (Ignition)
    Units       : SI (meters, kilograms, seconds)

    Author  : Team LiDAR-Inspect
    Project : 3D LiDAR-Based Shelter Damage Inspection System
    License : MIT
-->
<sdf version="1.7">
    <world name="damaged_shelter">

        <!-- ================================================================
             Physics Configuration
             ================================================================ -->
        <physics name="default_physics" type="ode">
            <real_time_update_rate>1000</real_time_update_rate>
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1</real_time_factor>
            <ode>
                <solver>
                    <type>quick</type>
                    <iters>150</iters>
                    <precon_iters>0</precon_iters>
                    <sor>1.400000</sor>
                    <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
                </solver>
                <constraints>
                    <cfm>0.0</cfm>
                    <erp>0.2</erp>
                    <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
                    <contact_surface_layer>0.01</contact_surface_layer>
                </constraints>
            </ode>
        </physics>

        <!-- ================================================================
             Lighting
             ================================================================ -->
        <!-- Directional sun light (reduced intensity simulates overcast disaster sky) -->
        <light name="sun" type="directional">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- Point light inside shelter (simulates emergency lantern) -->
        <light name="interior_lantern" type="point">
            <pose>4 3 1.5 0 0 0</pose>
            <diffuse>0.8 0.7 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <attenuation>
                <range>8</range>
                <constant>0.5</constant>
                <linear>0.1</linear>
                <quadratic>0.05</quadratic>
            </attenuation>
            <cast_shadows>false</cast_shadows>
        </light>

        <!-- ================================================================
             Ground Plane / Floor Slab
             ================================================================ -->
        <model name="floor_slab">
            <static>true</static>
            <pose>4 3 0 0 0 0</pose>
            <link name="floor_link">
                <collision name="floor_collision">
                    <geometry>
                        <box><size>8.0 6.0 0.10</size></box>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>0.9</mu>    <!-- Concrete floor friction -->
                                <mu2>0.9</mu2>
                            </ode>
                        </friction>
                    </surface>
                </collision>
                <visual name="floor_visual">
                    <geometry>
                        <box><size>8.0 6.0 0.10</size></box>
                    </geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/Grey</name>
                        </script>
                    </material>
                </visual>
            </link>
        </model>

        <!-- ================================================================
             South Wall — INTACT (1 m thick reinforced concrete)
             ================================================================ -->
        <model name="south_wall">
            <static>true</static>
            <pose>4.0 0 1.5 0 0 0</pose>
            <link name="link">
                <collision name="col">
                    <geometry><box><size>8.0 0.25 3.0</size></box></geometry>
                </collision>
                <visual name="vis">
                    <geometry><box><size>8.0 0.25 3.0</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/Concrete</name>
                        </script>
                    </material>
                </visual>
            </link>
        </model>

        <!-- ================================================================
             East Wall — INTACT
             ================================================================ -->
        <model name="east_wall">
            <static>true</static>
            <pose>8.0 3.0 1.5 0 0 0</pose>
            <link name="link">
                <collision name="col">
                    <geometry><box><size>0.25 6.0 3.0</size></box></geometry>
                </collision>
                <visual name="vis">
                    <geometry><box><size>0.25 6.0 3.0</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/Concrete</name>
                        </script>
                    </material>
                </visual>
            </link>
        </model>

        <!-- ================================================================
             North Wall — PARTIALLY COLLAPSED (right section only)
             Only the eastern 3 m of the 8 m north wall remains standing.
             The western 5 m section has collapsed — creating a large opening.
             ================================================================ -->
        <model name="north_wall_remaining">
            <static>true</static>
            <!-- Only the right 3 m portion remains -->
            <pose>6.5 6.0 1.5 0 0 0</pose>
            <link name="link">
                <collision name="col">
                    <geometry><box><size>3.0 0.25 3.0</size></box></geometry>
                </collision>
                <visual name="vis">
                    <geometry><box><size>3.0 0.25 3.0</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/Concrete</name>
                        </script>
                    </material>
                </visual>
            </link>
        </model>

        <!-- ================================================================
             West Wall — LEANING (5° tilt outward — pre-collapse state)
             ================================================================ -->
        <model name="west_wall_leaning">
            <static>true</static>
            <!-- Slight outward tilt: 0.087 rad = 5 degrees -->
            <pose>0.0 3.0 1.5 0 0.087 0</pose>
            <link name="link">
                <collision name="col">
                    <geometry><box><size>0.25 6.0 3.0</size></box></geometry>
                </collision>
                <visual name="vis">
                    <geometry><box><size>0.25 6.0 3.0</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/Bricks</name>
                        </script>
                    </material>
                </visual>
            </link>
        </model>

        <!-- ================================================================
             Roof — PARTIAL (hole in central section)
             ================================================================ -->
        <!-- Roof east panel (intact) -->
        <model name="roof_east">
            <static>true</static>
            <pose>6.5 3.0 3.05 0 0 0</pose>
            <link name="link">
                <collision name="col">
                    <geometry><box><size>3.0 6.0 0.15</size></box></geometry>
                </collision>
                <visual name="vis">
                    <geometry><box><size>3.0 6.0 0.15</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/DarkGrey</name>
                        </script>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Roof west panel (intact) -->
        <model name="roof_west">
            <static>true</static>
            <pose>1.5 3.0 3.05 0 0 0</pose>
            <link name="link">
                <collision name="col">
                    <geometry><box><size>3.0 6.0 0.15</size></box></geometry>
                </collision>
                <visual name="vis">
                    <geometry><box><size>3.0 6.0 0.15</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/DarkGrey</name>
                        </script>
                    </material>
                </visual>
            </link>
        </model>
        <!-- NOTE: Central roof section (x=3–5) is intentionally missing = HOLE -->

        <!-- ================================================================
             Debris — Collapsed Wall Rubble (NW corner)
             ================================================================ -->
        <model name="debris_block_1">
            <static>true</static>
            <pose>1.8 0.9 0.3 0.2 0.1 0.5</pose>
            <link name="link">
                <collision name="col">
                    <geometry><box><size>0.6 0.4 0.5</size></box></geometry>
                </collision>
                <visual name="vis">
                    <geometry><box><size>0.6 0.4 0.5</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/Rocky</name>
                        </script>
                    </material>
                </visual>
            </link>
        </model>

        <model name="debris_block_2">
            <static>true</static>
            <pose>2.4 1.3 0.2 -0.1 0.3 1.1</pose>
            <link name="link">
                <collision name="col">
                    <geometry><box><size>0.8 0.5 0.35</size></box></geometry>
                </collision>
                <visual name="vis">
                    <geometry><box><size>0.8 0.5 0.35</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/Concrete</name>
                        </script>
                    </material>
                </visual>
            </link>
        </model>

        <model name="debris_block_3">
            <static>true</static>
            <pose>1.2 1.8 0.15 0.0 0.0 0.8</pose>
            <link name="link">
                <collision name="col">
                    <geometry><box><size>0.5 0.5 0.3</size></box></geometry>
                </collision>
                <visual name="vis">
                    <geometry><box><size>0.5 0.5 0.3</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/Grey</name>
                        </script>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Debris from roof hole collapse (central area) -->
        <model name="debris_roof_fragment_1">
            <static>true</static>
            <pose>4.8 2.9 0.2 0.15 -0.2 0.3</pose>
            <link name="link">
                <collision name="col">
                    <geometry><box><size>0.9 0.7 0.25</size></box></geometry>
                </collision>
                <visual name="vis">
                    <geometry><box><size>0.9 0.7 0.25</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/DarkGrey</name>
                        </script>
                    </material>
                </visual>
            </link>
        </model>

        <model name="debris_roof_fragment_2">
            <static>true</static>
            <pose>5.3 3.4 0.1 -0.1 0.1 -0.5</pose>
            <link name="link">
                <collision name="col">
                    <geometry><box><size>0.6 0.6 0.2</size></box></geometry>
                </collision>
                <visual name="vis">
                    <geometry><box><size>0.6 0.6 0.2</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/DarkGrey</name>
                        </script>
                    </material>
                </visual>
            </link>
        </model>

        <!-- ================================================================
             TurtleBot3 Spawn Point Marker (invisible, aids spawner)
             ================================================================ -->
        <model name="robot_spawn_marker">
            <static>true</static>
            <pose>1.0 1.0 0.0 0 0 0</pose>
            <link name="link">
                <visual name="vis">
                    <geometry>
                        <cylinder><radius>0.05</radius><length>0.01</length></cylinder>
                    </geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/Green</name>
                        </script>
                    </material>
                </visual>
            </link>
        </model>

        <!-- ================================================================
             Scene Settings
             ================================================================ -->
        <scene>
            <ambient>0.3 0.3 0.4 1</ambient>    <!-- Slightly dark/overcast -->
            <background>0.5 0.6 0.7 1</background>
            <shadows>true</shadows>
            <fog>
                <color>0.7 0.7 0.7 1</color>
                <type>linear</type>
                <start>8.0</start>
                <end>20.0</end>
                <density>0.05</density>
            </fog>
        </scene>

    </world>
</sdf>
