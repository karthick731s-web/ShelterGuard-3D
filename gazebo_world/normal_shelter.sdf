<?xml version="1.0" ?>
<!--
    normal_shelter.sdf
    ===================
    Gazebo SDF world file defining an INTACT, undamaged single-storey shelter.

    This world serves as the baseline/comparison reference for the inspection system.
    Run this world first to establish what a healthy shelter scan looks like,
    then compare against the damaged_shelter.sdf results.

    Structure:
        - 4 intact walls (8m × 6m floor plan)
        - Complete flat roof
        - No debris, no holes
        - Uniform concrete materials

    Author  : Team LiDAR-Inspect
    Project : 3D LiDAR-Based Shelter Damage Inspection System
    License : MIT
-->
<sdf version="1.7">
    <world name="normal_shelter">

        <physics name="default_physics" type="ode">
            <real_time_update_rate>1000</real_time_update_rate>
            <max_step_size>0.001</max_step_size>
        </physics>

        <light name="sun" type="directional">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- Floor -->
        <model name="floor_slab">
            <static>true</static>
            <pose>4 3 0 0 0 0</pose>
            <link name="floor_link">
                <collision name="floor_collision">
                    <geometry><box><size>8.0 6.0 0.10</size></box></geometry>
                </collision>
                <visual name="floor_visual">
                    <geometry><box><size>8.0 6.0 0.10</size></box></geometry>
                    <material>
                        <script>
                            <name>Gazebo/Grey</name>
                        </script>
                    </material>
                </visual>
            </link>
        </model>

        <!-- North Wall — INTACT -->
        <model name="north_wall">
            <static>true</static>
            <pose>4.0 6.0 1.5 0 0 0</pose>
            <link name="link">
                <collision name="col"><geometry><box><size>8.0 0.25 3.0</size></box></geometry></collision>
                <visual name="vis">
                    <geometry><box><size>8.0 0.25 3.0</size></box></geometry>
                    <material><script><name>Gazebo/Concrete</name></script></material>
                </visual>
            </link>
        </model>

        <!-- South Wall — INTACT -->
        <model name="south_wall">
            <static>true</static>
            <pose>4.0 0.0 1.5 0 0 0</pose>
            <link name="link">
                <collision name="col"><geometry><box><size>8.0 0.25 3.0</size></box></geometry></collision>
                <visual name="vis">
                    <geometry><box><size>8.0 0.25 3.0</size></box></geometry>
                    <material><script><name>Gazebo/Concrete</name></script></material>
                </visual>
            </link>
        </model>

        <!-- East Wall — INTACT -->
        <model name="east_wall">
            <static>true</static>
            <pose>8.0 3.0 1.5 0 0 0</pose>
            <link name="link">
                <collision name="col"><geometry><box><size>0.25 6.0 3.0</size></box></geometry></collision>
                <visual name="vis">
                    <geometry><box><size>0.25 6.0 3.0</size></box></geometry>
                    <material><script><name>Gazebo/Concrete</name></script></material>
                </visual>
            </link>
        </model>

        <!-- West Wall — INTACT -->
        <model name="west_wall">
            <static>true</static>
            <pose>0.0 3.0 1.5 0 0 0</pose>
            <link name="link">
                <collision name="col"><geometry><box><size>0.25 6.0 3.0</size></box></geometry></collision>
                <visual name="vis">
                    <geometry><box><size>0.25 6.0 3.0</size></box></geometry>
                    <material><script><name>Gazebo/Concrete</name></script></material>
                </visual>
            </link>
        </model>

        <!-- Complete Roof — NO HOLES -->
        <model name="roof">
            <static>true</static>
            <pose>4.0 3.0 3.05 0 0 0</pose>
            <link name="link">
                <collision name="col"><geometry><box><size>8.0 6.0 0.15</size></box></geometry></collision>
                <visual name="vis">
                    <geometry><box><size>8.0 6.0 0.15</size></box></geometry>
                    <material><script><name>Gazebo/DarkGrey</name></script></material>
                </visual>
            </link>
        </model>

        <scene>
            <ambient>0.6 0.6 0.6 1</ambient>
            <background>0.7 0.8 0.9 1</background>
            <shadows>true</shadows>
        </scene>

    </world>
</sdf>
